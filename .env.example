# Local (same PC)
# VITE_API_URL=http://localhost:5000/api

# Local LAN (phone on same WiFi) — replace with your PC IP
# VITE_API_URL=http://192.168.x.x:5000/api

# Production (Render) — or use /api with vercel.json proxy
VITE_API_URL=https://kuldeep-malik-sports-academy-backend.onrender.com/api

# Optional: direct upload host for large videos (recommended on Vercel)
# VITE_UPLOAD_API_URL=https://kuldeep-malik-sports-academy-backend.onrender.com/api

# IMPORTANT — Render free disk is ephemeral:
# Database stays (Postgres). Raw /uploads files are wiped on every redeploy.
# Fixes in place:
#   1) New admin uploads are also saved in Postgres (media_blobs) and restored on boot
#   2) server/seed-media is restored automatically on boot
#   3) Optional manual sync from a machine that still has the files:
#        cd server
#        npm run sync:uploads
#   4) Optional brand repair on live CMS:
#        npm run fix:live-brand
