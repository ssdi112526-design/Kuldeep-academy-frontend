# Local (same PC)
# VITE_API_URL=http://localhost:5000/api

# Local LAN (phone on same WiFi) — replace with your PC IP
# VITE_API_URL=http://192.168.x.x:5000/api

# Production (Render) — or use /api with vercel.json proxy
VITE_API_URL=https://raghunandan-akhada-backend.onrender.com/api

# IMPORTANT — Render free disk is ephemeral:
# Database stays (Postgres). Image/video FILES in /uploads are wiped on every redeploy.
# Fix already in place:
#   1) server/seed-media is restored automatically on boot
#   2) After new uploads, refresh snapshot then commit:
#        cd server
#        robocopy uploads seed-media /E /XF .gitkeep
#        git add seed-media && git commit && git push
#   Or one-time sync without commit:
#        node scripts/pushUploadsToRender.js
